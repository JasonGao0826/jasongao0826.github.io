      "title": {
        "zh": "Woolworths Consumer Trust & Promotion Transparency Project",
        "en": "Woolworths Consumer Trust & Promotion Transparency Project"
      },
      "subtitle": {
        "zh": "课程团队项目｜商业分析｜消费者洞察",
        "en": "Course team project | Business analysis | Consumer insights"
      },
      "summary": {
        "zh": "围绕促销透明度与消费者信任，以消费者旅程、信任方程等工具梳理问题，形成团队分析海报与咨询提案",
        "en": "Exploring promotional transparency and consumer trust through customer journeys and the Trust Equation, presented in a team poster and consulting proposal"
      },
      "displayTitle": {
        "zh": "Woolworths",
        "en": "Woolworths"
      },
      "subject": {
        "zh": "Consumer Trust &\nPromotion Transparency",
        "en": "Consumer Trust &\nPromotion Transparency"
      },
      "kindLabel": {
        "zh": "团队课程项目",
        "en": "Course team project"
      },
      "participationLabel": {
        "zh": "参与整个项目流程",
        "en": "Participated throughout the project"
      },
      "sourceNote": {
        "zh": "项目范围为课程研究与咨询提案，未涵盖财务预测、司法判断或价格调整实施",
        "en": "The project scope was course research and a consulting proposal; it excluded financial forecasting, legal judgments and implementation of price changes"
      },
      "tags": [
        {
          "zh": "消费者信任",
          "en": "Consumer trust"
